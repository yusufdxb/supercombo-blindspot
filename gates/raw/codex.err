    82	
    83	def collect(six_list: list[np.ndarray], sess, slices) -> dict[str, np.ndarray]:
    84	    """Warm a fresh ModelStateMirror on `six_list`; return per-frame stacked
    85	    arrays for every tracked head, the model's predicted uncertainties, and its
    86	    internal recurrent feature vector."""
    87	    state = ModelStateMirror(session=sess, output_slices=slices)
    88	    rec: dict[str, list] = defaultdict(list)
    89	    prev = None
    90	    for six in six_list:
    91	        if prev is not None:
    92	            inp = stack_pair(prev, six)
    93	            p = state.run(inp, inp)
    94	            # scalar readouts
    95	            rec["accel_t0"].append(float(p["plan"][0, 0, 6]))
    96	            rec["desired_curv"].append(float(p["desired_curvature"][0, 0]))
    97	            rec["lead_prob"].append(float(p["lead_prob"][0, 0]))
    98	            # full heads (for the collapse map)
    99	            for name, key in _HEADS.items():
   100	                rec[name].append(np.asarray(p[key][0], dtype=np.float32).ravel())
   101	            rec["lane_lines_prob"].append(
   102	                np.asarray(p["lane_lines_prob"][0], dtype=np.float32))
   103	            # the model's own predicted uncertainty
   104	            rec["plan_std"].append(np.asarray(p["plan_stds"][0], dtype=np.float32).ravel())
   105	            rec["lead_std"].append(np.asarray(p["lead_stds"][0], dtype=np.float32).ravel())
   106	            rec["desired_curv_std"].append(float(p["desired_curvature_stds"][0, 0]))
   107	            # internal recurrent feature vector
   108	            rec["hidden_state"].append(
   109	                np.asarray(p["hidden_state"][0], dtype=np.float32))
   110	        prev = six
   111	    return {k: np.array(v) for k, v in rec.items()}
   112	
   113	
   114	HEAD_NAMES = list(_HEADS.keys())

