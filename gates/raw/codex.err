     1	"""CARLA RGB frame -> supercombo 12-channel input (Step 4 sim path).
     2	
     3	The key idea that keeps this faithful: a CARLA `sensor.camera.rgb` is an ideal
     4	pinhole. If we render it at the comma 3 fcam resolution (1928x1208) with the fov
     5	that reproduces fcam's focal length (2648 px), the rendered frame has *exactly*
     6	the intrinsics of `_ar_ox_config.fcam`. We can then reuse the verified Step 3.5
     7	warp (`get_warp_matrix` + `cv2.warpPerspective`) to map it into the 512x256
     8	medmodel frame.
     9	
    10	Real openpilot feeds `get_warp_matrix(device_from_calib_euler, fcam.intrinsics)`
    11	where the euler comes from `liveCalibration`. In sim the camera is mounted
    12	perfectly (we control the transform), so the calibration euler is exactly zero
    13	and the warp collapses to `K_fcam @ inv(K_medmodel)` — a pure intrinsic remap,
    14	no rotation. That is why no per-run calibration is needed in sim.
    15	
    16	Pipeline: RGB(1928x1208) --BT.601--> YUV420 --warp--> model YUV(256x512 / 128x256)
    17	--6ch split--> (6,128,256), then two frames stacked -> (1,12,128,256).
    18	
    19	The 6-channel split and the no-normalization rule are inherited verbatim from
    20	`warped_preprocessor` (the Step 3.5 path that hit 100% parity).
    21	"""
    22	
    23	from __future__ import annotations
    24	
    25	import math
    26	
    27	import numpy as np
    28	
    29	from src.preprocessor import rgb_to_yuv420
    30	from src.transformations import _ar_ox_config, get_warp_matrix, scaled_intrinsics
    31	from src.warped_preprocessor import stack_pair, warp_yuv_to_model, yuv_to_6ch
    32	
    33	# CARLA narrow camera is rendered at comma 3 fcam native resolution so that the
    34	# rendered intrinsics match `_ar_ox_config.fcam` exactly.
    35	CARLA_CAM_W = 1928
    36	CARLA_CAM_H = 1208
    37	
    38	# Zero calibration: the sim camera is mounted exactly on the device axes.
    39	ZERO_CALIB = np.zeros(3, dtype=np.float64)
    40	
    41	
    42	def _fov_deg_for_focal(focal_px: float, width_px: int) -> float:
    43	    """Horizontal fov (degrees) a pinhole of `focal_px` has at `width_px` wide.
    44	    CARLA's camera `fov` attribute is this horizontal fov."""
    45	    return math.degrees(2.0 * math.atan((width_px / 2.0) / focal_px))
    46	
    47	
    48	def fcam_fov_deg() -> float:
    49	    """fov to give a CARLA narrow camera so it reproduces comma 3 fcam intrinsics."""
    50	    fcam = _ar_ox_config.fcam
    51	    return _fov_deg_for_focal(fcam.focal_length, fcam.width)
    52	
    53	
    54	def ecam_fov_deg() -> float:
    55	    """fov for the wide camera, matching comma 3 ecam focal length.
    56	
    57	    NOTE: the real ecam is a fisheye; a CARLA pinhole at this fov is only a rough
    58	    stand-in. The supercombo `big_input_imgs` feed is handled in `scenario.py`,
    59	    which (per the verified Step 3.5 finding) feeds the narrow model frame to
    60	    both inputs. This wide camera exists for recording / overlays, not as a
    61	    faithful ecam."""
    62	    ecam = _ar_ox_config.ecam
    63	    return _fov_deg_for_focal(ecam.focal_length, ecam.width)
    64	
    65	
    66	def build_sim_warps() -> tuple[np.ndarray, np.ndarray]:
    67	    """(warp_y, warp_uv) homographies mapping the medmodel frame back into the
    68	    CARLA fcam-intrinsics camera frame, for full-res Y and half-res U/V."""
    69	    K = _ar_ox_config.fcam.intrinsics
    70	    warp_y = get_warp_matrix(ZERO_CALIB, K, bigmodel_frame=False)
    71	    warp_uv = get_warp_matrix(ZERO_CALIB, scaled_intrinsics(K, 0.5), bigmodel_frame=False)
    72	    return warp_y, warp_uv
    73	
    74	
    75	def rgb_to_model_6ch(rgb: np.ndarray, warp_y: np.ndarray, warp_uv: np.ndarray) -> np.ndarray:
    76	    """One CARLA RGB frame (1208x1928x3 uint8) -> (6, 128, 256) float32, no /255."""
    77	    if rgb.shape != (CARLA_CAM_H, CARLA_CAM_W, 3):
    78	        raise ValueError(f"expected RGB {(CARLA_CAM_H, CARLA_CAM_W, 3)}, got {rgb.shape}")
    79	    Y, U, V = rgb_to_yuv420(rgb)  # Y full-res, U/V half-res
    80	    Y_m, U_m, V_m = warp_yuv_to_model(Y, U, V, warp_y, warp_uv)
    81	    return yuv_to_6ch(Y_m, U_m, V_m)
    82	
    83	
    84	def rgb_to_model_input(prev_rgb: np.ndarray, curr_rgb: np.ndarray,
    85	                       warp_y: np.ndarray, warp_uv: np.ndarray) -> np.ndarray:
    86	    """Two consecutive CARLA RGB frames -> (1, 12, 128, 256) float32."""
    87	    prev6 = rgb_to_model_6ch(prev_rgb, warp_y, warp_uv)
    88	    curr6 = rgb_to_model_6ch(curr_rgb, warp_y, warp_uv)
    89	    return stack_pair(prev6, curr6)

