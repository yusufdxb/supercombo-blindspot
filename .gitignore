# report/figures/*.png ARE tracked (deliverable) — only data/ images are ignored.
# E5 layer cache is ~2.8 GB (6 backbone probes x 11 alphas x 319 frames); regenerate via --collect.
report/e5_collected.npz
# E5 v0.9.6 layer cache (same format, same size order); regenerate via python -m src.e5_layer_v096 --collect.
report/e5_v096_collected.npz
# E5 submodule cache is ~100 MB (8 downstream probes, 11 alphas, 319 frames); regenerate via `python -m src.e5_submodule --collect`.
report/e5_submodule_collected.npz
# E7 corruption cache (76 conditions x 319 frames x 512-D, ~2+ GB); regenerate via `python -m src.e7_corruption --collect`.
report/e7_collected.npz
# E4-RAM cache (~40 MB, same structure as e4_collected.npz); regenerate via `python -m src.e4_ram --collect`.
report/e4_ram_collected.npz
# Ablations cache (small, regenerate via `python -m scripts.ablations`).
report/ablations_collected.npz
# Humanizer intermediate scratch (de-AI pass working files).
.humanizer_work/
# Scratch candidate models downloaded during the second-model upgrade scout.
models/candidates/
